{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start validation with parameters from JSON",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": [
                "validation_parameters.json"
            ]
        },
        {
            "name": "Generate featureclasses from JSON",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/scripts",
            "module": "JSON_file_to_classes",
            "args": [
                "--input", "../json/mcd.json",
                "--output", "../json/generated/",
                "--specs", "../validation_specs/dv1/"
            ]
        }
    ]
}
